# Production. Runs either profile. Host for software only sites, DPU where BlueField is fitted.
# Every gate on, warnings fatal.
BNK_ENV_NAME=production
BNK_DEFAULT_PROFILE=dpu
BNK_DEPLOYMENT_SIZE=Large
BNK_STORAGECLASS=nfs
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=true
BNK_REQUIRE_LICENSE=true
BNK_STRICT_PREFLIGHT=true
BNK_WAIT_TIMEOUT=2400
