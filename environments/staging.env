# Staging. Mirrors production. Runs either profile, and should run whichever production runs.
BNK_ENV_NAME=staging
BNK_DEFAULT_PROFILE=dpu
BNK_DEPLOYMENT_SIZE=Large
BNK_STORAGECLASS=nfs
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=true
BNK_REQUIRE_LICENSE=true
BNK_STRICT_PREFLIGHT=false
BNK_WAIT_TIMEOUT=1800
