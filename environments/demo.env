# Demo. Customer facing, still disposable. Runs either profile.
BNK_ENV_NAME=demo
BNK_DEFAULT_PROFILE=host
BNK_DEPLOYMENT_SIZE=Medium
BNK_STORAGECLASS=standard
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=false
BNK_REQUIRE_LICENSE=true
BNK_STRICT_PREFLIGHT=false
BNK_WAIT_TIMEOUT=900
