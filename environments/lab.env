# Lab. Throwaway clusters, CI, Instruqt sandboxes. Runs either profile.
BNK_ENV_NAME=lab
BNK_DEFAULT_PROFILE=host
BNK_DEPLOYMENT_SIZE=Small
BNK_STORAGECLASS=standard
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=false
BNK_REQUIRE_LICENSE=false
BNK_STRICT_PREFLIGHT=false
# 1800, not 600. A lab is usually the coldest cluster you will ever run this on, with nothing in the
# local image cache, and the release manifest is 81 components. A fresh three node cluster pulling all
# of them from repo.f5.com took longer than ten minutes, which made the installer give up on a stack
# that was still coming up correctly. Short timeouts belong to warm clusters, not to small ones.
BNK_WAIT_TIMEOUT=1800
