# BNK on Host. TMM is a software pod on host CPU.
# No scalable functions, no SR-IOV, no VFIO, no NetworkAttachmentDefinitions. The f5-tmm chart
# ships network.attachment empty with vfio.enabled false, and the CNEInstance CRD requires only
# certificate, deploymentSize, manifestVersion, product and registry.
BNK_PROFILE_NAME=host
BNK_DPU_ENABLED=false
# Caller may override these (a lab that gives TMM gretap-backed macvlan legs sets attachments + a
# lower MTU). This file is sourced AFTER the caller's exports, so a bare assignment would silently
# wipe them - keep the ${VAR:-default} form. Defaults are unchanged: 1500, no attachments.
BNK_TMM_MTU="${BNK_TMM_MTU:-1500}"
BNK_DYNAMIC_ROUTING="${BNK_DYNAMIC_ROUTING:-false}"
BNK_NETWORK_ATTACHMENTS="${BNK_NETWORK_ATTACHMENTS:-}"   # empty by default, host mode needs none
BNK_ZEBOS_STATE=
BNK_NEEDS_HUGEPAGES=true            # TMM requests hugepages-2Mi in every profile
BNK_NEEDS_SRIOV=false
