# BNK on DPU. TMM runs on BlueField-3 with DOCA offload.
# Assumes node provisioning is already done: DOCA, a flashed BlueField, scalable functions with
# trust on, OVS bridges and hugepages. If it is not, use deploy/dpubnkctl instead.
BNK_PROFILE_NAME=dpu
BNK_DPU_ENABLED=true
BNK_TMM_MTU=9000
BNK_DYNAMIC_ROUTING=true
BNK_NETWORK_ATTACHMENTS=sf-external,sf-internal
BNK_ZEBOS_STATE=legacy
BNK_NEEDS_HUGEPAGES=true
BNK_NEEDS_SRIOV=true
