# Per site variables. Copy to env/<site>.env and edit. Nothing here is secret.
# This file is what makes the deployment portable instead of Tokyo specific.

POC_NAME=example-poc
CUSTOMER_NAME="Example Customer"
AIRGAP_MODE=online                 # online or offline

# --- hosts ---
HOST_USER=ubuntu
HOST_ADDR=172.28.13.16             # control plane server, reachable from the jumphost
DPU_ADDR=192.168.100.2             # DPU over tmfifo

# --- DPU dataplane bridges ---
# Physical uplinks and the scalable function representors to enslave.
DPU_EXT_BRIDGE=sf-external
DPU_EXT_UPLINK=p0
DPU_EXT_SF_REP=en3f0pf0sf1
DPU_EXT_PF_REP=pf0hpf
DPU_EXT_ADDR=192.168.40.5/24

DPU_INT_BRIDGE=sf-internal
DPU_INT_UPLINK=p1
DPU_INT_SF_REP=en3f1pf1sf1
DPU_INT_PF_REP=pf1hpf
DPU_INT_ADDR=192.168.50.5/24

# --- host dataplane interfaces (the PFs facing the DPU) ---
HOST_EXT_IFACE=enp13s0f0np0
HOST_EXT_ADDR=192.168.40.16/24
HOST_INT_IFACE=enp13s0f1np1
HOST_INT_ADDR=192.168.50.16/24
HOST_DATAPLANE_MTU=9000

# Stale interfaces to remove if a previous run left them behind. Space separated, may be empty.
HOST_STALE_LINKS="external40 internal50"

# --- wizard corrections, applied to poc.yaml after discovery ---
WIZARD_DPU_COUNT=1
WIZARD_LAG_ENABLED=false
WIZARD_NFS_SERVER=
WIZARD_NFS_PATH=
